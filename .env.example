# --- shared (Vercel + VPS) ---
DATABASE_URL=postgres://user:pass@host-pooler/db?sslmode=require
# direct (non-pooled) URL, used only by `pnpm --filter @cobra/db migrate`; falls back to DATABASE_URL
DATABASE_URL_UNPOOLED=
RPC_URL=https://forno.celo.org
ROUTER_ADDRESS=
ROUTER_DEPLOY_BLOCK=
PUBLIC_BASE_URL=https://cobra.example
# --- router v2 / Textile FX RFQ (docs/DEPLOY.md "Passage au routeur v2"); all optional, v1 behaviour when unset ---
# Previous (v1) router, still followed by the indexer and listed on /proof + landing after ROUTER_ADDRESS moves to v2.
# Worker (VPS): both variables together. Web (Vercel): the address only.
LEGACY_ROUTER_ADDRESS=
LEGACY_ROUTER_DEPLOY_BLOCK=
# Textile partner (aggregator) API key. SERVER-SIDE ONLY: Vercel server env + VPS worker env, never NEXT_PUBLIC_.
# Enables RFQ quotes (web) and the post-broadcast submit report (worker). Needs ROUTER_ADDRESS = a v2 router.
TEXTILE_API_KEY=
# "false" switches Textile off without removing the key
TEXTILE_ENABLED=

# --- web (Vercel) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_ATTRIBUTION_CODE=celo_502e1bea2794
FX_API_KEY=
# >= 32 random chars; same value on Vercel (verifies) and in the bot process (signs /panel links)
DASHBOARD_SECRET=
# ERC-8004 agent address shown on /proof (public)
AGENT_ADDRESS=

# --- worker (VPS only) ---
ATTRIBUTION_CODE=celo_502e1bea2794
OPERATOR_TELEGRAM_CHAT_ID=
KILL_SWITCH=false
# RELAYER_PRIVATE_KEY lives ONLY in the VPS systemd EnvironmentFile, never here, never on Vercel.
