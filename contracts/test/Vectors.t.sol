pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {ICobraRouter} from "../src/ICobraRouter.sol";
import {CobraRouterHarness} from "./utils/CobraRouterHarness.sol";

/// @notice Cross-language parity: every hash in test/vectors/eip712.json (generated by
///         packages/shared/scripts/gen-vectors.ts) must be reproduced by the Solidity router.
contract VectorsTest is Test {
    string internal json;
    CobraRouterHarness internal router;

    function setUp() public {
        json = vm.readFile(string.concat(vm.projectRoot(), "/test/vectors/eip712.json"));
        vm.chainId(vm.parseJsonUint(json, ".chainId"));
        address at = vm.parseJsonAddress(json, ".router");
        // Constructor args are irrelevant to hashing; non-zero placeholders.
        deployCodeTo("CobraRouterHarness.sol:CobraRouterHarness", abi.encode(address(0xbeef1), address(0xbeef2)), at);
        router = CobraRouterHarness(at);
        assertEq(block.chainid, 42220);
        assertEq(address(router).code.length > 0, true);
    }

    function _invoice() internal view returns (ICobraRouter.Invoice memory inv) {
        inv.id = vm.parseJsonBytes32(json, ".invoice.id");
        inv.merchant = vm.parseJsonAddress(json, ".invoice.merchant");
        inv.tokenOut = vm.parseJsonAddress(json, ".invoice.tokenOut");
        inv.amountOut = vm.parseJsonUint(json, ".invoice.amountOut");
        inv.deadline = vm.parseJsonUint(json, ".invoice.deadline");
    }

    function test_typeStringsAndHashes() public view {
        // Type strings the router hashes / passes to Permit2 must equal the TS ones byte for byte.
        assertEq(router.exposed_PERMIT2_WITNESS_TYPE_STRING(), vm.parseJsonString(json, ".typeStrings.PERMIT2_WITNESS"));
        assertEq(
            keccak256(bytes(router.exposed_PERMIT2_WITNESS_TYPE_STRING())),
            vm.parseJsonBytes32(json, ".typeHashes.PERMIT2_WITNESS")
        );
        assertEq(router.exposed_INVOICE_TYPEHASH(), vm.parseJsonBytes32(json, ".typeHashes.Invoice"));
        assertEq(router.exposed_LEG_COMMITMENT_TYPEHASH(), vm.parseJsonBytes32(json, ".typeHashes.LegCommitment"));
        assertEq(router.exposed_PAYMENT_INTENT_TYPEHASH(), vm.parseJsonBytes32(json, ".typeHashes.PaymentIntent"));
        // Sanity: the JSON's typeHashes are keccak of its typeStrings.
        string[5] memory keys =
            ["Invoice", "LegCommitment", "PaymentIntent", "PERMIT2_WITNESS", "ReceiveWithAuthorization"];
        for (uint256 i; i < keys.length; ++i) {
            assertEq(
                keccak256(bytes(vm.parseJsonString(json, string.concat(".typeStrings.", keys[i])))),
                vm.parseJsonBytes32(json, string.concat(".typeHashes.", keys[i])),
                keys[i]
            );
        }
        assertEq(
            keccak256(
                "ReceiveWithAuthorization(address from,address to,uint256 value,uint256 validAfter,uint256 validBefore,bytes32 nonce)"
            ),
            vm.parseJsonBytes32(json, ".typeHashes.ReceiveWithAuthorization")
        );
    }

    function test_invoiceHash() public view {
        assertEq(router.hashInvoice(_invoice()), vm.parseJsonBytes32(json, ".invoiceHash"));
    }

    function test_domainSeparator() public view {
        bytes32 expected = keccak256(
            abi.encode(
                keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)"),
                keccak256("Cobra Router"),
                keccak256("1"),
                uint256(42220),
                address(router)
            )
        );
        assertEq(router.DOMAIN_SEPARATOR(), expected);
    }

    function test_cases() public view {
        ICobraRouter.Invoice memory inv = _invoice();
        address payer = vm.parseJsonAddress(json, ".payer");
        uint256 nCases;
        for (uint256 c; vm.keyExistsJson(json, string.concat(".cases[", vm.toString(c), "]")); ++c) {
            string memory base = string.concat(".cases[", vm.toString(c), "]");
            string memory name = vm.parseJsonString(json, string.concat(base, ".name"));

            uint256 n;
            while (vm.keyExistsJson(json, string.concat(base, ".legs[", vm.toString(n), "]"))) ++n;
            ICobraRouter.Leg[] memory legs = new ICobraRouter.Leg[](n);
            for (uint256 i; i < n; ++i) {
                string memory lb = string.concat(base, ".legs[", vm.toString(i), "]");
                legs[i].token = vm.parseJsonAddress(json, string.concat(lb, ".token"));
                legs[i].amountIn = vm.parseJsonUint(json, string.concat(lb, ".amountIn"));
                legs[i].kind = ICobraRouter.PullKind(vm.parseJsonUint(json, string.concat(lb, ".kind")));
                legs[i].path = vm.parseJsonBytes(json, string.concat(lb, ".path"));
                // pullData is NOT committed: random garbage must not change any hash.
                legs[i].pullData = abi.encode(keccak256(abi.encode(c, i)));
                assertEq(keccak256(legs[i].path), vm.parseJsonBytes32(json, string.concat(lb, ".pathHash")), name);
            }

            assertEq(
                router.hashIntent(inv, payer, legs), vm.parseJsonBytes32(json, string.concat(base, ".intentHash")), name
            );
            bytes32 digest = router.intentDigest(inv, payer, legs);
            assertEq(digest, vm.parseJsonBytes32(json, string.concat(base, ".intentDigest")), name);
            for (uint256 i; i < n; ++i) {
                assertEq(
                    router.exposed_legNonce(digest, i),
                    vm.parseJsonBytes32(json, string.concat(base, ".legNonces[", vm.toString(i), "]")),
                    name
                );
            }
            ++nCases;
        }
        assertEq(nCases, 3, "expected 3 vector cases");
    }
}
