{
  "name": "cobra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "pnpm -r --workspace-concurrency=2 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:e2e": "vitest run --root apps/worker --config vitest.e2e.config.ts",
    "vectors": "pnpm --filter @cobra/shared vectors",
    "contracts:test": "cd contracts && forge test",
    "deploy:router": "cd contracts && forge build && cd .. && tsx scripts/agent/deploy-router.ts",
    "agent:register": "tsx scripts/agent/register.ts",
    "verify:deploy": "tsx scripts/ops/verify-deploy.ts",
    "dev:web": "pnpm --filter @cobra/web dev",
    "dev:worker": "pnpm --filter @cobra/worker dev"
  },
  "devDependencies": {
    "@neon/config": "1.10.0",
    "@neon/env": "1.6.8",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "viem": "2.57.14",
    "vitest": "3.2.4"
  }
}
